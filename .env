# Local development settings for docker compose. NOT for production.

# Public domain served by nginx. Add the hosts to C:\Windows\System32\drivers\etc\hosts (see README).
DOMAIN=shopapp.local
NGINX_HTTP_PORT=80

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_HOST_PORT=5432

# pgAdmin
PGADMIN_EMAIL=admin@shopapp.local
PGADMIN_PASSWORD=admin

# Keycloak bootstrap admin (master realm)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Kafka bootstrap port published on the host (in-network: kafka:9092)
KAFKA_HOST_PORT=29092

# Public Keycloak URL = token issuer base. Must match how browsers reach nginx:
# append :<port> when NGINX_HTTP_PORT is not 80, e.g. http://identity.${DOMAIN}:8000
KEYCLOAK_URL=http://identity.${DOMAIN}

# Product service Liquibase contexts: "sample-data" loads the dev catalog; "default" (or empty) = schema only
PRODUCT_LIQUIBASE_CONTEXTS=sample-data

# Keycloak client secrets (local dev values from identity/realm-export.json)
CUSTOMER_MANAGEMENT_CLIENT_SECRET=R8h9ZAofh4TCOp-iuGdzwfFA5orV_wHb
STOREFRONT_BFF_CLIENT_SECRET=LbicBnJFx8lMtjpQJTUURytZoXAXAT30
BACKOFFICE_BFF_CLIENT_SECRET=QAHenhvlUDailIgh5tBuCmxbhNfkSygm

# Debezium CDC (kafka-connect): replication-only Postgres login for the product connector (decisions.md 4-3)
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=debezium-dev
