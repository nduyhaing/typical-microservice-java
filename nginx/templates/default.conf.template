# Grafana (observability add-on, docker-compose.observability.yml). Resolved per request like every upstream, so nginx
# starts and serves the shop without it; 502 while it is not running (decisions.md 6-11).
server {
    listen ${NGINX_HTTP_PORT};
    server_name grafana.${DOMAIN};

    location / {
        set $upstream_grafana grafana:3000;
        proxy_pass http://$upstream_grafana;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # Grafana Live (websocket)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
