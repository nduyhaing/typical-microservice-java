# Rendered by the nginx image at startup: ${DOMAIN} and ${NGINX_HTTP_PORT} come from the environment (.env).

# Look containers up through Docker's DNS on each request (cached 10 s) instead of once at startup, so a rebuilt
# container (new IP) keeps working without restarting nginx (decisions.md 2b-8). Upstreams are variables for this.
resolver 127.0.0.11 valid=10s ipv6=off;

proxy_buffer_size 128k;
proxy_buffers 4 256k;
proxy_busy_buffers_size 256k;

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Unknown host names are dropped.
server {
    listen ${NGINX_HTTP_PORT} default_server;
    return 444;
}

server {
    listen ${NGINX_HTTP_PORT};
    server_name identity.${DOMAIN};

    location / {
        set $upstream_identity identity:8080;
        proxy_pass http://$upstream_identity;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        # browser-supplied trace context is not continued (decisions.md 6-62); the api host keeps it: the BFFs and
        # services call it themselves and propagate their own
        proxy_set_header traceparent "";
        proxy_set_header tracestate "";
        proxy_set_header baggage "";
    }
}

server {
    listen ${NGINX_HTTP_PORT};
    server_name api.${DOMAIN};

    # media uploads: a 10 MB file plus its multipart overhead; the media service enforces 10 MB per file (3b-23)
    client_max_body_size 11m;

    # Product's order-only stock endpoints: the order service calls them inside the compose network
    # (http://product:8080); never through the gateway, where any signed-in customer could take stock (3c-63).
    location ~* ^/product/+backoffice/+products/+(subtract|restore)-quantity {
        default_type application/json;
        return 403 '{"statusCode":"403 FORBIDDEN","title":"Forbidden","detail":"Not available through the API gateway","fieldErrors":[]}';
    }

    # Service-to-service endpoints (/<service>/internal/..., realm role SERVICE: order gives a cancelled order's
    # stock and coupon use back, payment marks an order paid) are called inside the compose network only (5-5).
    location ~* ^/+[^/]+/+internal(/|$) {
        default_type application/json;
        return 403 '{"statusCode":"403 FORBIDDEN","title":"Forbidden","detail":"Not available through the API gateway","fieldErrors":[]}';
    }

    # Actuator endpoints (metrics, ...) are for the compose network / observability stack only; health stays public
    # for checks. Matches /<service>/actuator... (also "actuator;x" or "actuatorx") unless it is .../actuator/health
    # (decisions.md 6-13).
    location ~* ^/+[^/]+/+actuator(?!/+health(/|$)) {
        default_type application/json;
        return 404 '{"statusCode":"404 NOT_FOUND","title":"Not Found","detail":"Not available through the gateway","fieldErrors":[]}';
    }

    location /product/ {
        set $upstream_product product:8080;
        proxy_pass http://$upstream_product;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /cart/ {
        set $upstream_cart cart:8080;
        proxy_pass http://$upstream_cart;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /customer/ {
        set $upstream_customer customer:8080;
        proxy_pass http://$upstream_customer;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /order/ {
        set $upstream_order order:8080;
        proxy_pass http://$upstream_order;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /media/ {
        set $upstream_media media:8080;
        proxy_pass http://$upstream_media;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /tax/ {
        set $upstream_tax tax:8080;
        proxy_pass http://$upstream_tax;
        proxy_set_header Host $http_host;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /location/ {
        set $upstream_location location:8080;
        proxy_pass http://$upstream_location;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /inventory/ {
        set $upstream_inventory inventory:8080;
        proxy_pass http://$upstream_inventory;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # search is public; nginx does not wait for it, so Elasticsearch down never keeps the shop from starting (4-18)
    location /search/ {
        set $upstream_search search:8080;
        proxy_pass http://$upstream_search;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # similar products (public) and its reindex (ADMIN); nginx does not wait for it: the product page hides the
    # section when it is down (decisions.md 5-45)
    location /recommendation/ {
        set $upstream_recommendation recommendation:8080;
        proxy_pass http://$upstream_recommendation;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Promotion's coupon usage endpoints: only the order service calls them, inside the compose network
    # (http://promotion:8080); through the gateway any customer could burn or give back coupon uses (4-75).
    location ~* ^/promotion/+storefront/+promotions/+(apply|release)-usage {
        default_type application/json;
        return 403 '{"statusCode":"403 FORBIDDEN","title":"Forbidden","detail":"Not available through the API gateway","fieldErrors":[]}';
    }

    location /promotion/ {
        set $upstream_promotion promotion:8080;
        proxy_pass http://$upstream_promotion;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /rating/ {
        set $upstream_rating rating:8080;
        proxy_pass http://$upstream_rating;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # payments (customer init/capture/cancel, public provider list, admin providers and payments); nginx does not
    # wait for it: the storefront's pay step says payments are unavailable when it is down (decisions.md 5-18)
    location /payment/ {
        set $upstream_payment payment:8080;
        proxy_pass http://$upstream_payment;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # payment-paypal is internal only (the payment service calls it on the network with its SERVICE token): never
    # through the gateway (decisions.md 5-22)
    location /payment-paypal/ {
        default_type application/json;
        return 403 '{"statusCode":"403 FORBIDDEN","title":"Forbidden","detail":"Not available through the API gateway","fieldErrors":[]}';
    }

    # webhooks admin (ADMIN only, through backoffice-bff); nginx does not wait for it (decisions.md 5-36)
    location /webhook/ {
        set $upstream_webhook webhook:8080;
        proxy_pass http://$upstream_webhook;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # admin-only sample data loader; nginx does not wait for it (a dev convenience, decisions.md 5-50)
    location /sampledata/ {
        set $upstream_sampledata sampledata:8080;
        proxy_pass http://$upstream_sampledata;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Any other path: no service there (yet).
    location / {
        default_type application/json;
        return 404 '{"detail":"no services yet"}';
    }
}

