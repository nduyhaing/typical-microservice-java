        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /promotion/ {
        set $upstream_promotion promotion:8080;
        proxy_pass http://$upstream_promotion;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /rating/ {
        set $upstream_rating rating:8080;
        proxy_pass http://$upstream_rating;
        proxy_set_header Host $http_host;
        # never pass client-supplied forwarding headers that could pick the base URL (decisions.md 2b-12)
